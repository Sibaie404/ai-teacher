    { "type": "write_math", "id": "form",  "region": "Left",  "latex": "% change = (new − old) / old × 100", "style": { "size": "lg", "emphasis": true, "color": "accent" } },
    { "type": "draw_bar_chart", "id": "bars", "region": "WorkArea", "title": "Price", "bars": [ { "label": "Old", "value": 50 }, { "label": "New", "value": 65 } ] },
    { "type": "write_math", "id": "step1", "region": "Left",  "latex": "new − old = 65 − 50 = 15" },
