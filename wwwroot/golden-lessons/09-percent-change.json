  "grade": "9",
  "learningGoal": "Compute percent change with (new - old) / old × 100.",
  "spokenLines": [
    "Percent change tells you how much something grew or shrank.",
    "Formula: new minus old, divided by old, times one hundred.",
    "Say a shirt goes from fifty dollars to sixty five.",
    "New minus old is fifteen.",
    "Divide by the old, fifty. That's zero point three.",
    "Times one hundred: thirty percent increase.",
    "If the number is negative, that's a decrease instead."
  ],
  "timings": [0.0, 3.5, 8.5, 13.0, 16.5, 21.0, 26.0],
