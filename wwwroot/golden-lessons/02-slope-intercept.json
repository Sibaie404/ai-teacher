  "grade": "9-10",
  "learningGoal": "Read slope and y-intercept from y = mx + b and graph the line.",
  "spokenLines": [
    "Slope-intercept form.",
    "y equals m x plus b.",
    "m is the slope — rise over run.",
    "b is the y-intercept, where the line crosses the y-axis.",
    "Let's graph y equals two x plus one.",
    "Set up our axes.",
    "b is one, so plot zero comma one.",
    "Slope is two: up two, right one. Plot one comma three.",
    "Connect the points and we've got our line."
  ],
  "timings": [0.0, 2.5, 5.5, 10.0, 15.0, 18.0, 21.5, 26.5, 32.0],
