    { "type": "write_text", "id": "m",     "region": "Left",  "text": "m = slope (rise/run)" },
    { "type": "write_text", "id": "b",     "region": "Left",  "text": "b = y-intercept" },
    { "type": "write_math", "id": "ex",    "region": "Left",  "latex": "y = 2x + 1", "style": { "emphasis": true, "color": "accent" } },
